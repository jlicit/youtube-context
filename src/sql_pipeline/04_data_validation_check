/*
How to use:
- Replace {{project_id}} and {{dataset}} with your values (or search/replace).
- Run in BigQuery Console as a single script, or copy/paste sections as needed.
- Intended to validate:
  1) Sessions table health
  2) Weekly rollup counts vs sessions table
  3) Hours watched consistency
  4) Weighted vs unweighted cuts sanity
  5) Spike finding (outliers)
  6) Week bucket correctness in PT (America/Los_Angeles)
*/

-- Tables / Views used:
--   {{project_id}}.{{dataset}}.sessions_features_tbl
--   {{project_id}}.{{dataset}}.weekly_metrics_vw

-- 1) Sessions table health

SELECT
  COUNT(*) AS row_count,
  SUM(CASE WHEN events_in_session < 1 THEN 1 ELSE 0 END) AS bad_event_counts,
  SUM(CASE WHEN session_total_time_s < 0 THEN 1 ELSE 0 END) AS negative_time,
  SUM(CASE WHEN session_total_time_s = 0 THEN 1 ELSE 0 END) AS zero_time_sessions,
  MIN(session_start_ts) AS min_ts,
  MAX(session_start_ts) AS max_ts
FROM `{{project_id}}.{{dataset}}.sessions_features_tbl`;

-- Notes:
-- - bad_event_counts > 0 suggests bad sessionization or null event joins.
-- - negative_time should be 0; zero_time_sessions are usually parsing or idle-tail issues.

-- 2) Do weekly rollup counts match raw sessions?
WITH w AS (
  SELECT
    TIMESTAMP_TRUNC(session_start_ts, WEEK(MONDAY), 'America/Los_Angeles') AS week_start,
    COUNT(*) AS sessions
  FROM `{{project_id}}.{{dataset}}.sessions_features_tbl`
  GROUP BY week_start
)
SELECT
  w.week_start,
  w.sessions AS raw_sessions,
  m.sessions AS view_sessions,
  (w.sessions = m.sessions) AS counts_match
FROM w
JOIN `{{project_id}}.{{dataset}}.weekly_metrics_vw` m USING (week_start)
ORDER BY week_start DESC;

-- Expectation:
-- - counts_match should be TRUE for all weeks. Any FALSE row needs a join/filter audit in the view.

-- 3) Does hours_watched equal SUM(session_total_time_s)/3600 per week?
WITH w AS (
  SELECT
    TIMESTAMP_TRUNC(session_start_ts, WEEK(MONDAY), 'America/Los_Angeles') AS week_start,
    SUM(session_total_time_s)/3600.0 AS hours_calc
  FROM `{{project_id}}.{{dataset}}.sessions_features_tbl`
  GROUP BY week_start
)
SELECT
  m.week_start,
  m.hours_watched,
  ROUND(w.hours_calc, 2) AS hours_calc,
  ABS(m.hours_watched - ROUND(w.hours_calc, 2)) AS abs_diff
FROM `{{project_id}}.{{dataset}}.weekly_metrics_vw` m
JOIN w USING (week_start)
ORDER BY week_start DESC;

-- Expectation:
-- - abs_diff should be ~0; small differences can arise from rounding behavior in the view.

-- 4) Weighted vs. unweighted sanity (recent 12 weeks)
SELECT
  week_start,
  mean_cuts_per_min_unweighted,
  mean_cuts_per_min_time_weighted,
  (mean_cuts_per_min_time_weighted - mean_cuts_per_min_unweighted) AS delta
FROM `{{project_id}}.{{dataset}}.weekly_metrics_vw`
ORDER BY week_start DESC
LIMIT 12;

-- Interpretation:
-- - delta near zero is common if durations are similar across sessions.
-- - Large positive delta implies longer sessions have higher cuts/min; negative implies the opposite.

-- 5) Spike finder: unusually long sessions or extreme cuts
SELECT
  session_id,
  session_start_ts,
  session_total_time_s,
  session_mean_cuts_per_min,
  events_in_session
FROM `{{project_id}}.{{dataset}}.sessions_features_tbl`
WHERE session_total_time_s > 6*3600
   OR session_mean_cuts_per_min > 60
ORDER BY session_total_time_s DESC
LIMIT 50;

-- Tip:
-- - Investigate spikes for data glitches (paused tabs, multi-day sessions, parsing errors).

-- 6) PT week bucket check (boundary weeks around local midnight)
SELECT
  session_id,
  session_start_ts,
  TIMESTAMP_TRUNC(session_start_ts, WEEK(MONDAY), 'America/Los_Angeles') AS week_start,
  EXTRACT(HOUR FROM DATETIME(session_start_ts, 'America/Los_Angeles')) AS hour_local
FROM `{{project_id}}.{{dataset}}.sessions_features_tbl`
WHERE EXTRACT(HOUR FROM DATETIME(session_start_ts, 'America/Los_Angeles')) IN (0, 23)
ORDER BY session_start_ts DESC
LIMIT 50;

-- Interpretation:
-- - Scan for sessions near day boundaries to confirm correct week grouping in PT.
